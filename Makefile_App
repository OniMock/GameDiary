TARGET = GameDiaryApp

APP_NAME := GameDiary


PROJECT_VERSION  := $(shell head -n 1 VERSION)
PROJECT_CODENAME := $(shell sed -n '2p' VERSION)
ifeq ($(PROJECT_CODENAME),)
PROJECT_CODENAME := Skyfall
endif

# -----------------------------------------------------------------------
# Sources (AUTO — sem lista manual de .o)
# -----------------------------------------------------------------------
APP_SRCS := $(shell find src/app -name "*.c" -o -name "*.cpp")
COMMON_SRCS := $(shell find src/common -name "*.c" -o -name "*.cpp")

SRCS := $(APP_SRCS) $(COMMON_SRCS)

# Build in a separate directory to avoid collisions with the plugin objects
OBJDIR = obj/app
OBJS := $(addprefix $(OBJDIR)/, $(SRCS:.c=.o))
OBJS := $(OBJS:.cpp=.o)

# -----------------------------------------------------------------------
# Rules
# -----------------------------------------------------------------------
$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# -----------------------------------------------------------------------
# Compiler / flags
# -----------------------------------------------------------------------
INCDIR = include

CFLAGS = -O2 -Os -G0 -Wall -Wextra \
         -D_PSP_FW_VERSION=661 -DGDIARY_APP \
         -DAPP_TITLE=\"$(APP_NAME)\" \
         -DAPP_VERSION=\"$(PROJECT_VERSION)\" \
         -DAPP_CODENAME=\"$(PROJECT_CODENAME)\" \
         -DSDK_VERSION=\"$(shell psp-gcc -dumpversion)\" \
         -DBUILD_YEAR=$(shell date +'%Y') \
         -DBUILD_MONTH=$(shell date +'%m' | sed 's/^0//') \
         -DBUILD_DAY=$(shell date +'%d' | sed 's/^0//') \
         -Iinclude \
         -Iinclude/app \
         -Ilib

ifneq ($(VERSION_URL),)
CFLAGS += -DVERSION_ENDPOINT="\"$(VERSION_URL)\""
endif

ifeq ($(DEBUG), 1)
CFLAGS += -DGDIARY_DEBUG
endif

CXXFLAGS = $(CFLAGS)
ASFLAGS  = $(CFLAGS)

# C++ compiler (importante no PSP)
CXX = psp-g++

# -----------------------------------------------------------------------
# Build type (APP ONLY)
# -----------------------------------------------------------------------
BUILD_PRX = 0
PSP_EBOOT_TITLE = GameDiary
PSP_FW_VERSION = 661

# EBOOT Metadata Assets
PSP_EBOOT_ICON = assets-src/ICON0.PNG
PSP_EBOOT_PIC0 = assets-src/PIC0.PNG
PSP_EBOOT_PIC1 = assets-src/PIC1.PNG
PSP_EBOOT_SND0 = assets-src/SND0.AT3

# -----------------------------------------------------------------------
# Libraries
# -----------------------------------------------------------------------
LIBS = \
	-lintrafont \
	-lpspgum \
	-lpspgu \
	\
	-lpng \
	-lz \
	-lm \
	-lstdc++ \
	\
	-lcurl \
	-lmbedtls \
	-lmbedx509 \
	-lmbedcrypto \
	-lpspssl \
	-lpspaudio \
	-lpspwlan

USE_PSPSDK_NETWVINET = 1
USE_PSPSDK_LIBC = 1

# -----------------------------------------------------------------------
# SDK
# -----------------------------------------------------------------------
PSPSDK = $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak

# -----------------------------------------------------------------------
# Default build
# -----------------------------------------------------------------------
all: EBOOT.PBP
